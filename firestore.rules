rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Users
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Chats
    match /chats/{chatId} {
      allow read, write: if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth();
      allow read, write: if isAdmin();
    }

    // Messages
    match /messages/{chatId}/msgs/{msgId} {
      allow read, write: if isAuth() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      allow read, write: if isAdmin();
    }

    // Appeals
    match /appeals/{appealId} {
      allow create: if isAuth();
      allow read, update: if isAdmin();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isAuth() && resource.data.toUserId == request.auth.uid;
      allow create: if isAuth();
      allow update, delete: if isAdmin();
    }

    // Verification Requests
    match /verificationRequests/{reqId} {
      allow create: if isAuth() && request.auth.uid == request.resource.data.userId;
      allow read, update: if isAdmin();
    }
  }
}
